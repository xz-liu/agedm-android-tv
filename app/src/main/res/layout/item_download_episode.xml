<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginEnd="8dp" android:layout_marginBottom="8dp"
    android:background="@drawable/bg_focusable_small" android:focusable="true"
    android:focusableInTouchMode="true" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/age_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/stateText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/age_focus" android:maxLines="1" android:ellipsize="end" />
    <ProgressBar android:id="@+id/downloadProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
        android:progressTint="@color/age_focus" android:progressBackgroundTint="@color/age_surface_alt" android:max="100" />
    <TextView android:id="@+id/speedText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/age_text_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
